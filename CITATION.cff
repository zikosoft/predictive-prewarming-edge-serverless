    given-names: "Zakaria"
    orcid: "https://orcid.org/0009-0001-8692-4575"
license: MIT
repository-code: "https://github.com/zikosoft/predictive-prewarming-edge-serverless"
version: "3.0.0"
date-released: "2026-09-03"
keywords:
  - serverless computing
  - cold start
  - predictive autoscaling
  - container orchestration
  - edge computing
  - reproducible research
